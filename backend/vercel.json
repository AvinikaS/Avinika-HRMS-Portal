{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node"
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/server.js"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/birthdays",
            "schedule": "30 2 * * *"
        },
        {
            "path": "/api/cron/absent",
            "schedule": "30 9 * * *"
        },
        {
            "path": "/api/cron/payroll",
            "schedule": "0 0 1 * *"
        }
    ]
}